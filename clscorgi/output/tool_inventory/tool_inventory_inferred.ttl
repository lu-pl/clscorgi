<https://clscor.io/entity/3022d1e9-31c3-41d4-9aa7-ac5a58d5f3e8> a ns1:PC0_Typed_CRM_Property,
        ns1:PC3_has_note,
        rdfs:Resource,
        owl:Thing ;
    ns1:P01_has_domain <https://clscor.io/entity/d2f889a154> ;
    ns1:P03_has_range_literal "KonText is an advanced and customizable corpus query engine built above the Manatee library of NoSketch Engine. KonText is intended for professional use and deployment in organizations with many users, rather than for home use. Its main features are: full support for parallel corpora, partial support for syntactically annotated and spoken corpora. Manatee is a token-based backend that is fast and scalable, but its support for corpora with complex annotation (organized in multiple interfering layers) is limited." ;
    ns1:P3.1_has_type ns2:tool_description ;
    owl:sameAs <https://clscor.io/entity/3022d1e9-31c3-41d4-9aa7-ac5a58d5f3e8> .

