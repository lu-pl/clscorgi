    ns1:P01_has_domain <https://clscor.io/entity/4dd1f51c76> ;
    ns1:P03_has_range_literal """This tool is an R library that allows for using the UDPipe 1 parser directly within R. Besides, it provides a range of handy functions for text mining, such as basic frequency statistics, collocation analysis, key word extraction, and topic modeling with Latent Dirichlet Allocation as well as Latent Semantic Analysis.
This tool is compatible with UDPipe1, UDPipe Language Models.""" ;
    ns1:P3.1_has_type ns2:tool_description ;
    owl:sameAs <https://clscor.io/entity/26c35e9c-c0b8-4885-a478-9c4775874e46> .

