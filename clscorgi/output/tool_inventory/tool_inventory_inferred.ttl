    ns1:P177_assigned_property_of_type ns2:Y9_expects_input ;
    ns1:P2_has_type ns2:Y9_expects_input ;
    ns1:P3_has_note """The input for UDPipe 2 parser must be UTF-encoded text without any other markup. Structuring options:
- CoNLL-U
- horizontal (each sentence on a separate line)
- vertical (each token on a separate line, with an empty line denoting end of the sentence.  
For details, see https://lindat.mff.cuni.cz/services/udpipe/api-reference.php and look for Method process, parameter input.""" ;
    owl:sameAs <https://clscor.io/entity/1fdacafe-0d70-4926-8a62-8eb7dfc4a7cd> .

